{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wecom-context://contracts/core-protocol.schema.json",
  "title": "WeCom Context Core Protocol",
  "type": "object",
  "properties": {
    "protocol_version": { "const": "1" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ok": { "type": "boolean" },
    "data": {},
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": false
    }
  },
  "required": ["protocol_version", "request_id", "ok"],
  "oneOf": [
    { "properties": { "ok": { "const": true }, "data": {} }, "required": ["data"], "not": { "required": ["error"] } },
    { "properties": { "ok": { "const": false }, "error": {} }, "required": ["error"], "not": { "required": ["data"] } }
  ],
  "additionalProperties": false
}
