{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wecom-context://contracts/app-config.schema.json",
  "title": "WeCom Context App Config (settings + sidecar state, v2)",
  "type": "object",
  "properties": {
    "protocol_version": { "const": "1" },
    "configVersion": { "const": 2 },
    "default_model": { "type": "string", "minLength": 1 },
    "pi_path": { "type": "string", "minLength": 1 },
    "terminal": { "enum": ["iterm", "terminal"] },
    "max_messages": { "type": "integer", "minimum": 1, "maximum": 100 },
    "max_context_tokens": { "type": "integer", "minimum": 100, "maximum": 100000 },
    "snapshot_max_age_minutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
    "automatic_injection": { "const": false },
    "vault_root": { "type": "string", "minLength": 1 },
    "data_dir": { "type": "string", "minLength": 1 },
    "selected_dataset_id": { "type": "string", "minLength": 1 },
    "selection_mode": {
      "enum": ["explicit", "auto"],
      "description": "explicit = 用户显式切换的企业，bootstrap 不得自动抢回；auto（缺失时的默认值）= 允许按当前登录账号自动跟随"
    },
    "snapshotMode": { "enum": ["fixed"] },
    "activeSnapshotPath": { "type": "string", "minLength": 1 },
    "activeSnapshotCreatedAt": { "type": "string", "minLength": 1 },
    "activeSnapshotDatasetId": { "type": "string", "minLength": 1 },
    "selected_session_key": { "type": "string", "minLength": 1 },
    "session_bindings": {
      "type": "object",
      "description": "唯一权威的会话绑定表，键为 <dataset_id>:<session_key>",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "session_key": { "type": "string", "minLength": 1 },
          "conversation_id": { "type": "string", "minLength": 1 },
          "dataset_id": { "type": "string", "minLength": 1 },
          "snapshot_id": { "type": "string", "minLength": 1 },
          "snapshot_path": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["active", "history"] },
          "bound_at": { "type": "string", "minLength": 1 }
        },
        "required": ["session_key", "conversation_id", "dataset_id", "snapshot_id", "snapshot_path", "mode", "bound_at"],
        "additionalProperties": false
      }
    },
    "allowSendToWecom": { "type": "boolean" },
    "sendConfirmedAt": { "type": "string" },
    "lastDatasetScan": { "type": ["object", "null"] },
    "lastDatasetDiscovery": { "type": ["object", "null"] },
    "custom_providers": {
      "type": "array",
      "maxItems": 1,
      "description": "唯一支持的模型供应商是 DeepSeek 官方 API；模型 id 来自用户 API Key 对应的 /models 响应。",
      "items": {
        "type": "object",
        "properties": {
          "provider_id": { "const": "deepseek" },
          "display_name": { "const": "DeepSeek 官方" },
          "base_url": { "const": "https://api.deepseek.com" },
          "api": { "const": "openai-completions" },
          "api_key": { "type": "string", "minLength": 1 },
          "auth_header": { "const": false },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "enabled": { "const": true },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 2, "maxLength": 96, "pattern": "^deepseek-[a-z0-9._-]+$" },
                "name": { "type": "string", "minLength": 1, "maxLength": 96 },
                "reasoning": { "type": "boolean" },
                "input_images": { "const": false },
                "context_window": { "type": "integer", "minimum": 1 },
                "max_tokens": { "type": "integer", "minimum": 1 },
                "thinking_level_map": { "type": ["object", "null"], "additionalProperties": { "type": ["string", "null"] } },
                "compat": { "type": ["object", "null"] }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          },
          "updated_at": { "type": "string" }
        },
        "required": ["provider_id", "display_name", "base_url", "api", "api_key", "enabled", "models"],
        "additionalProperties": false
      }
    }
  },
  "required": ["protocol_version", "default_model", "pi_path", "terminal", "max_messages", "max_context_tokens", "snapshot_max_age_minutes", "automatic_injection"]
}
